# Шаблон секретов. Скопируй в .env и заполни. .env в git не попадает.

# Бесплатный ключ: aistudio.google.com → Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Локальные модели (ключи не нужны, нужен запущенный ollama serve)
OLLAMA_MODEL=gemma4:cloud

# Запасной бесплатный ключ: openrouter.ai (free-модели)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Claude API (Phase B): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
