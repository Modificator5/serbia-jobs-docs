{
  "name": "serbia-jobs",
  "version": "0.2.0",
  "private": true,
  "description": "Агрегатор вакансий Сербии + словарь сербских слов для русскоязычных",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "runAll": "bash tools/daily.sh",
    "scrape": "node scrapers/infostud.js",
    "scrape:infostud": "node scrapers/infostud.js",
    "scrape:kp": "node scrapers/kupujemprodajem.js",
    "scrape:ho": "node scrapers/halooglasi.js",
    "scrape:hw": "node scrapers/helloworld.js",
    "translate": "node tools/translate-titles.js",
    "enrich": "node tools/batch-enrich.js",
    "import:glossary": "node tools/import-glossary.js",
    "export:snapshot": "node tools/export-csv.js",
    "export:json": "node tools/export-json.js",
    "cleanup": "node tools/cleanup.js",
    "viewer": "node viewer/server.js",
    "check": "node tools/check.js",
    "test": "node tools/check.js && node tests/parsers.test.js && node tests/publish.test.js && node tests/enrich.test.js",
    "doctor": "node tools/doctor.js",
    "docs:check": "node tools/docs-check.js",
    "verify": "node tools/doctor.js && npm test && node tools/docs-check.js",
    "test:parsers": "node tests/parsers.test.js",
    "publish:telegram": "node tools/publish-telegram.js",
    "test:publish": "node tests/publish.test.js"
  }
}
